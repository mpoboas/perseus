{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC plus explicitly listed app commands only. No fs, shell, opener, or dialog grants (the folder picker is invoked from Rust).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-pick-and-open-repo",
    "allow-close-repo",
    "allow-stream-commits",
    "allow-cancel-stream",
    "allow-list-refs",
    "allow-commit-detail",
    "allow-commit-files",
    "allow-repo-status",
    "allow-stage-paths",
    "allow-unstage-paths",
    "allow-create-commit",
    "allow-switch-ref",
    "allow-new-branch",
    "allow-run-git-op"
  ]
}
