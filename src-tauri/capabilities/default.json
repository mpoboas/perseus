{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC plus explicitly listed app commands only. No fs, shell, opener, or dialog grants (the folder picker is invoked from Rust).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-pick-and-open-repo",
    "allow-close-repo",
    "allow-stream-commits",
    "allow-cancel-stream",
    "allow-list-refs",
    "allow-commit-detail",
    "allow-commit-files",
    "allow-repo-status",
    "allow-stage-paths",
    "allow-unstage-paths",
    "allow-create-commit",
    "allow-switch-ref",
    "allow-new-branch",
    "allow-run-git-op",
    "allow-cancel-git-op",
    "allow-git-action",
    "allow-list-stashes",
    "allow-list-remotes",
    "allow-file-history",
    "allow-file-blame",
    "allow-commit-template",
    "allow-search-commits",
    "allow-init-repo",
    "allow-clone-repo",
    "allow-open-in",
    "allow-list-conflicts",
    "allow-conflict-detail",
    "allow-resolve-conflict",
    "allow-rebase-plan",
    "allow-interactive-rebase",
    "allow-predict-merge",
    "allow-predict-pick",
    "allow-hosting-info",
    "allow-list-pull-requests",
    "allow-create-pull-request",
    "allow-merge-pull-request",
    "allow-list-issues",
    "allow-ci-state",
    "allow-checkout-pull-request",
    "allow-open-in-browser",
    "allow-watch-askpass",
    "allow-answer-askpass",
    "allow-list-submodules",
    "allow-update-submodules",
    "allow-open-nested-repo",
    "allow-list-worktrees",
    "allow-add-worktree",
    "allow-remove-worktree",
    "allow-lfs-status",
    "allow-lfs-track",
    "allow-large-staged-files",
    "allow-activity-log",
    "allow-commit-signature",
    "allow-generate-ssh-key",
    "allow-export-patch",
    "allow-apply-patch-file",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-set-active-profile",
    "allow-set-credential",
    "allow-remove-credential",
    "allow-pick-ssh-key",
    "allow-oauth-presets",
    "allow-oauth-sign-in",
    "allow-oauth-cancel",
    "allow-list-recent-repos",
    "allow-open-recent-repo",
    "allow-remove-recent-repo",
    "allow-watch-repo",
    "allow-unwatch-repo"
  ]
}
